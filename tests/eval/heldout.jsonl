{"id":"h17","cmd":"rsync -av ./ prod:/var/www","expect":"confirm","note":"覆盖远端目录"}
{"id":"h18","cmd":"echo $AWS_SECRET_ACCESS_KEY","expect":"confirm","note":"把密钥打到 stdout，会进日志"}
